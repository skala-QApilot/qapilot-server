# 로컬 인프라 환경변수 — `cp .env.example .env` 후 필요시 수정.
# docker-compose.yml 과 Spring/FastAPI 가 같은 값을 공유.

# --- PostgreSQL ---
POSTGRES_USER=qapilot
POSTGRES_PASSWORD=qapilot
POSTGRES_DB=qapilot
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/qapilot

# --- Redis (Celery broker + SSE pub/sub) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3 호환, 로컬 객체 저장소) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qapilot-local
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true
